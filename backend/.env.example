# -----------------------------------------------------------------------------
# Inventory Management System - environment variables
# Copy this file to `.env` (never committed) and replace the values.
# `docker compose` reads `backend/.env` automatically.
# -----------------------------------------------------------------------------

# --- Spring profile ---------------------------------------------------------
# development : local setup (ddl-auto update, Swagger on, verbose logs)
# production  : hardened setup (Swagger off, WARN logs, minimal Actuator)
# Required: no profile is active by default.
SPRING_PROFILES_ACTIVE=development

# --- PostgreSQL database ----------------------------------------------------
# Required in production. Development defaults:
# jdbc:postgresql://localhost:5432/inventory, postgres / postgres
DB_URL=jdbc:postgresql://localhost:5432/inventory
DB_USERNAME=postgres
DB_PASSWORD=change-me

# --- JWT authentication -----------------------------------------------------
# Required in production: at least 32 characters (HS256 = 256 bits).
# Generate one with e.g.: openssl rand -base64 48
JWT_SECRET=change-me-with-a-random-secret-of-at-least-32-chars
# Token lifetime in milliseconds (default: 86400000 = 24 h)
JWT_EXPIRATION=86400000

# --- Cloudinary (product image storage) -------------------------------------
# Required in every profile. Free account: https://cloudinary.com
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# --- CORS -------------------------------------------------------------------
# Allowed frontend origins, comma-separated.
# Default: localhost:3000 / 5173 / 4200 (and 127.0.0.1).
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Server & uploads (optional) --------------------------------------------
SERVER_PORT=8080
MAX_FILE_SIZE=5MB
MAX_REQUEST_SIZE=6MB
